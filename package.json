{
  "name": "skulgo-offline",
  "private": true,
  "version": "0.1.0",
  "description": "Offline-first, node-based school records platform.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm --workspace @skulgo/admin run dev",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
